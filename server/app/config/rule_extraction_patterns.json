{
  "version": "1.0",
  "email": {
    "default_query": "newer_than:30d (policy OR circular OR update) (denied OR denial OR \"claim denied\" OR rule OR limit)",
    "label_ids": ["INBOX"],
    "max_results": 20
  },
  "tpa_detection": {
    "patterns": [
      "\\bTPA\\s*[:\\-]?\\s*([A-Za-z0-9_\\- ]{2,64})\\b"
    ]
  },
  "rule_types": {
    "comparators": {
      "limit": "max",
      "minimum": "min"
    }
  },
  "semantic": {
    "enabled": true,
    "amount_regex": "(?i)(?:₹|INR|RS\\.?|Rupees)?\\s*([0-9][0-9,\\.]*\\s*(?:k|K|lakh|L)?)",
    "min_keyword_hits": 1,
    "excerpt_context": 120,
    "base_confidence": 0.55,
    "per_keyword_bonus": 0.06,
    "max_keyword_bonus": 0.24,
    "rule_types": [
      { "id": "limit", "rule_type": "limit", "keywords": ["limit", "maximum", "max", "up to", "not exceed"], "confidence_bonus": 0.08 }
    ],
    "categories": [
      { "id": "room_rent", "category": "room_rent", "keywords": ["room rent", "room charges"], "unit": "INR/day", "confidence_bonus": 0.06, "conditions": { "scope": "general" } }
    ]
  },
  "patterns": [
    {
      "id": "room_rent_limit_generic",
      "enabled": true,
      "rule_type": "limit",
      "category": "room_rent",
      "tpa_regex": ".*",
      "regex": "(?i)room\\s*rent[^\\d₹]{0,60}(?:₹|INR)?\\s*([0-9][0-9,\\.]*\\s*(?:k|K|lakh|L)?)\\s*(?:/(?:day|night)|per\\s*day|per\\s*night)?",
      "unit": "INR/day",
      "base_confidence": 0.7,
      "excerpt_context": 80,
      "conditions": {
        "scope": "general"
      }
    }
  ]
}
