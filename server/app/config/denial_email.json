{
  "version": "1.0",
  "gmail": {
    "enabled": true,
    "default_query": "subject:(denied OR denial) OR \"claim denied\"",
    "label_ids": ["INBOX"],
    "max_results": 10
  },
  "parsing": {
    "claim_id_patterns": ["\\bclaim\\s*(?:id|#|number)\\s*[:\\-#]?\\s*([A-Za-z0-9\\-]{6,})\\b", "\\bclaim_id\\s*[:\\-]?\\s*([A-Za-z0-9\\-]{6,})\\b"],
    "rejection_code_patterns": ["\\brejection\\s*code\\s*[:\\-]?\\s*([A-Za-z0-9\\-]{2,16})\\b", "\\b([A-Z]{2,6}\\d{1,4})\\b"],
    "strip_html": true,
    "max_text_chars": 8000
  },
  "gemini": {
    "enabled": true,
    "min_text_chars": 40
  }
}
